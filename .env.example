# Copy to .env (and load it, or `set` these in your shell) before running:
#   python merge_and_load.py --target sqlserver
#
# Never commit a real .env file -- add it to .gitignore.

AWS_SQL_SERVER=your-db-instance.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com,1433
AWS_SQL_DATABASE=your_database_name
AWS_SQL_USERNAME=your_username
AWS_SQL_PASSWORD=your_password
AWS_SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
